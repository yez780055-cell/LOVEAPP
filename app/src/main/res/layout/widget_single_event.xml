<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:orientation="vertical" android:padding="12dp"
    android:background="#FFF8F4" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_title" android:text="选择一个纪念日" android:textColor="#302A2A"
        android:textSize="14sp" android:maxLines="1" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/widget_days" android:text="添加事件后显示天数" android:textColor="#7A6268"
        android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
